{
  "name": "pocket-reader",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:web": "node scripts/build-site.mjs",
    "build:mobile": "node scripts/build-site.mjs --native",
    "mobile:sync": "npm run build:mobile && cap sync android",
    "mobile:android": "cap open android",
    "test": "node --test tests/*.test.mjs",
    "check": "npm test && npm --prefix ai-infra-board test",
    "mobile:sync:ios": "npm run build:mobile && cap sync ios",
    "mobile:ios": "cap open ios",
    "preview": "node scripts/preview.mjs",
    "test:browser": "playwright test",
    "build:service": "node scripts/build-edge.mjs"
  },
  "dependencies": {
    "@capacitor/core": "8.6.2",
    "@capacitor/android": "8.6.2",
    "@capacitor/ios": "8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.0",
    "@capacitor/preferences": "^8.0.0",
    "@capacitor/share": "^8.0.0",
    "@capacitor/status-bar": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.2",
    "esbuild": "^0.25.12",
    "@playwright/test": "^1.58.0"
  }
}
