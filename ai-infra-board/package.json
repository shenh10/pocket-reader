{
  "name": "ai-infra-board",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch src/server/index.ts",
    "dev:web": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production tsx src/server/index.ts",
    "catch-up": "tsx src/server/cli.ts catch-up",
    "test": "node --import tsx --test scripts/*.test.ts",
    "fetch": "tsx src/server/cli.ts fetch",
    "fetch-range": "tsx src/server/cli.ts fetch-range",
    "reanalyze": "tsx src/server/cli.ts reanalyze",
    "export-static": "tsx src/server/cli.ts export-static",
    "notify:test": "tsx src/server/cli.ts notify-test",
    "db:check": "tsx src/server/cli.ts db-check",
    "db:setup": "tsx src/server/cli.ts db-setup",
    "supabase:schema": "supabase db query --linked --file db/schema.sql",
    "supabase:seed": "supabase db query --linked --file db/repositories.sql",
    "supabase:setup": "npm run supabase:schema && npm run supabase:seed",
    "env:supabase": "bash scripts/write-supabase-env.sh",
    "db:up": "npm run db:setup",
    "db:local:start": "LC_ALL=en_US.UTF-8 /opt/homebrew/opt/postgresql@16/bin/pg_ctl -D /opt/homebrew/var/postgresql@16 -l /tmp/ai-infra-homebrew-postgres.log -o \"-p 54329\" start",
    "db:local:stop": "/opt/homebrew/opt/postgresql@16/bin/pg_ctl -D /opt/homebrew/var/postgresql@16 stop",
    "db:docker:up": "docker compose up -d postgres",
    "db:docker:down": "docker compose down",
    "db:docker:logs": "docker compose logs -f postgres",
    "build:pages": "npm run export-static -- --out public/data && tsc --noEmit && VITE_STATIC_DATA=true vite build"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "lucide-react": "^0.468.0",
    "luxon": "^3.5.0",
    "node-cron": "^4.6.0",
    "pg": "^8.13.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/luxon": "^3.4.2",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.6"
  }
}
